---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { formatDate, getTranslation, langOf, postUrl, readingMinutes, type Post } from "@/lib/blog";
import { localePath, t } from "@/i18n/ui";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const lang = langOf(post);
const tr = t(lang);
const { Content } = await render(post);
const translation = await getTranslation(post);
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternate={translation ? postUrl(translation) : null}
  type="article"
>
  <article class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <a href={localePath(lang, "/blog/")} class="font-mono text-sm text-dim hover:text-fg">← {tr("blog.back")}</a>
    <header class="mt-8 border-b border-line pb-8">
      <p class="font-mono text-xs text-faint">
        {formatDate(post.data.date, lang)} · {readingMinutes(post)} {tr("blog.read")}
      </p>
      <h1 class="mt-3 text-3xl leading-tight font-bold text-white sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 text-lg text-dim">{post.data.description}</p>
      <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs">
        {post.data.tags.map((tag) => <li class="text-purple">#{tag}</li>)}
      </ul>
    </header>
    <div class="prose-post mt-8">
      <Content />
    </div>
  </article>
</Base>
