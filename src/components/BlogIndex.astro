---
import Base from "@/layouts/Base.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import type { Lang } from "@/data/profile";
import { formatDate, getPosts, postUrl, readingMinutes } from "@/lib/blog";
import { t } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} title={tr("blog.title")} description={tr("blog.description")}>
  <div class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <SectionTitle id="blog" cmd="ls -t ~/blog">{tr("blog.title")}</SectionTitle>
    <p class="-mt-4 mb-10 text-dim">{tr("blog.description")}</p>
    {posts.length === 0 && <p class="text-dim">{tr("blog.empty")}</p>}
    <ul class="space-y-3">
      {
        posts.map((post) => (
          <li>
            <a href={postUrl(post)} class="block rounded-lg border border-line bg-panel p-5 transition-colors hover:border-purple/70">
              <p class="font-mono text-xs text-faint">
                {formatDate(post.data.date, lang)} · {readingMinutes(post)} {tr("blog.read")}
              </p>
              <h2 class="mt-1 text-lg font-semibold text-white">{post.data.title}</h2>
              <p class="mt-1 text-dim">{post.data.description}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5 font-mono text-xs">
                {post.data.tags.map((tag) => (
                  <li class="text-purple">#{tag}</li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
