---
import Base from "@/layouts/Base.astro";
---

<Base lang="pt" title="404" alternate={null}>
  <div class="mx-auto max-w-3xl px-4 pt-24 font-mono sm:px-6">
    <p class="text-sm text-faint"><span class="text-purple">$</span> cd {Astro.url.pathname}</p>
    <p class="mt-2 text-red">bash: cd: {Astro.url.pathname}: No such file or directory</p>
    <h1 class="mt-8 text-4xl font-bold text-white">404</h1>
    <p class="mt-3 font-sans text-dim">Essa página não existe. / This page doesn't exist.</p>
    <div class="mt-8 flex gap-3 text-sm">
      <a href="/" class="rounded-md bg-purple px-4 py-2 font-semibold text-bg">cd ~</a>
      <a href="/en/" class="rounded-md border border-line px-4 py-2 hover:border-purple">cd ~/en</a>
    </div>
  </div>
</Base>
